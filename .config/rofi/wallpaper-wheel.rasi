configuration {
    show-icons: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    background-color: transparent;
    text-color: #cdd6f4;
    font: "JetBrainsMono Nerd Font 10";
}

window {
    width: 85%;
    location: center;
    anchor: center;
    background-color: rgba(24, 24, 37, 0.85);
    border: 2px;
    border-color: #89b4fa;
    border-radius: 18px;
    padding: 20px;
}

mainbox {
    spacing: 15px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: rgba(49, 50, 68, 0.7);
    border-radius: 10px;
    padding: 10px 15px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: #89b4fa;
    padding: 0 10px 0 0;
}

listview {
    columns: 5;
    lines: 1;
    flow: horizontal;
    spacing: 16px;
    fixed-height: true;
    fixed-columns: true;
    cycle: true;
}

element {
    orientation: vertical;
    padding: 12px;
    border-radius: 14px;
    background-color: rgba(49, 50, 68, 0.4);
}

element selected {
    background-color: rgba(137, 180, 250, 0.25);
    border: 2px;
    border-color: #89b4fa;
}

element-icon {
    size: 210px;
    horizontal-align: 0.5;
    border-radius: 10px;
}

element-text {
    horizontal-align: 0.5;
    padding: 8px 0 0 0;
}
